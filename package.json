{
  "name": "modelprojectangular",
  "version": "0.0.0",
  "engines": {
    "node": ">=18.19.0 <19 || >=20.5.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:spa": "ng serve --configuration=development",
    "start:ssr": "ng serve --configuration=with-ssr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --watch=false --code-coverage",
    "serve:ssr:modelprojectangular": "node dist/modelprojectangular/server/server.mjs",
    "format": "prettier --check \"**/*.{ts,js,json,md,scss,html}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,json,md,scss,html}\"",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.0.8",
    "@angular/cdk": "21.0.6",
    "@angular/common": "21.0.8",
    "@angular/compiler": "21.0.8",
    "@angular/core": "21.0.8",
    "@angular/forms": "21.0.8",
    "@angular/material": "21.0.6",
    "@angular/platform-browser": "21.0.8",
    "@angular/platform-browser-dynamic": "21.0.8",
    "@angular/platform-server": "21.0.8",
    "@angular/router": "21.0.8",
    "@angular/ssr": "21.0.5",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/raleway": "^5.1.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/build": "21.0.5",
    "@angular/cli": "21.0.5",
    "@angular/compiler-cli": "21.0.8",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.19.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.4.47",
    "prettier": "3.7.4",
    "puppeteer": "^22.15.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,html}": ["ng lint --fix", "prettier --write"],
    "*.{scss,json,md}": ["prettier --write"]
  }
}
