{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:headless:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run build:*)"
    ],
    "ask": ["Bash(git push:*)"],
    "deny": ["Read(./**/*.pfx)", "Read(./**/*.p12)", "Read(./**/*.key)", "Read(./**/*.pem)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short"
          }
        ]
      }
    ]
  }
}
